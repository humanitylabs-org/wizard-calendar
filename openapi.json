{
  "openapi": "3.0.3",
  "info": {
    "title": "Wizard Calendar API",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Service identity and setup status",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "summary": "Visible snapshot; no network calls",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          }
        }
      }
    },
    "/api/export": {
      "get": {
        "summary": "Complete saved snapshot including hidden calendars",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          }
        }
      }
    },
    "/api/import": {
      "post": {
        "summary": "Atomically replace snapshot; see OSCAR-SETUP.md for schema and limits",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          }
        }
      }
    },
    "/api/preferences/import": {
      "post": {
        "summary": "Optional owner-run legacy hidden/color import; see OSCAR-SETUP.md",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "type": "object", "required": ["calendars", "hidden"],
          "properties": {
            "calendars": {"type": "array", "maxItems": 100, "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 300}, "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}}},
            "hidden": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
          }
        }}}},
        "responses": {
          "200": {"description": "Applied known preferences; matched local count and unmatched old ids returned"},
          "400": {"description": "Invalid preferences; nothing written"},
          "403": {"description": "Untrusted Host or Origin"}
        }
      }
    },
    "/api/calendars/visibility": {
      "post": {
        "summary": "Set visible boolean for a known calendar id",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "summary": "Stateless JSON-RPC MCP: calendar_events and sync_status read-only tools",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          }
        }
      }
    },
    "/api/sync": {
      "get": {
        "summary": "Read grant-scoped Connected accounts sync state",
        "responses": {
          "200": {
            "description": "Sync state, last_success, last_error, accounts, calendar_errors, setup_url, syncing and interval_minutes"
          }
        }
      },
      "post": {
        "summary": "Request asynchronous sync now; poll GET until syncing is false",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued or coalesced with pending refresh"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Service identity and setup status",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          }
        }
      }
    }
  }
}
