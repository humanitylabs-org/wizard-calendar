{
  "openapi": "3.0.3",
  "info": {
    "title": "Wizard Calendar API",
    "version": "0.3.0"
  },
  "paths": {
    "/api": {
      "get": {"summary": "API route index and manual-link supersessions", "responses": {"200": {"description": "Calendar API index"}, "403": {"description": "Untrusted Host or Origin"}}}
    },
    "/api/connect/start": {
      "get": {"summary": "Superseded by Connected accounts", "responses": {"410": {"description": "Manual linking retired; setup_url /wizard-connectors/ and superseded_by Connected accounts"}, "403": {"description": "Untrusted Host or Origin"}}},
      "post": {"summary": "Superseded by Connected accounts; credentials are not processed", "responses": {"410": {"description": "Manual linking retired; setup_url /wizard-connectors/ and superseded_by Connected accounts"}, "403": {"description": "Untrusted Host or Origin"}}}
    },
    "/api/connect/finish": {
      "get": {"summary": "Superseded by Connected accounts", "responses": {"410": {"description": "Manual linking retired; setup_url /wizard-connectors/ and superseded_by Connected accounts"}, "403": {"description": "Untrusted Host or Origin"}}},
      "post": {"summary": "Superseded by Connected accounts; callback codes are not processed", "responses": {"410": {"description": "Manual linking retired; setup_url /wizard-connectors/ and superseded_by Connected accounts"}, "403": {"description": "Untrusted Host or Origin"}}}
    },
    "/healthz": {
      "get": {
        "summary": "Service identity and setup status",
        "responses": {
          "200": { "description": "Success" },
          "400": { "description": "Invalid input" },
          "403": { "description": "Untrusted Host or Origin" }
        }
      }
    },
    "/api/events": {
      "get": {
        "summary": "Visible read-only snapshot; no network calls",
        "responses": {
          "200": { "description": "Success" },
          "400": { "description": "Invalid input" },
          "403": { "description": "Untrusted Host or Origin" }
        }
      }
    },
    "/api/export": {
      "get": {
        "summary": "Complete saved snapshot including hidden calendars",
        "responses": {
          "200": { "description": "Success" },
          "400": { "description": "Invalid input" },
          "403": { "description": "Untrusted Host or Origin" }
        }
      }
    },
    "/api/import": {
      "post": {
        "summary": "Atomically replace snapshot; see OSCAR-SETUP.md for schema and limits",
        "responses": {
          "200": { "description": "Success" },
          "400": { "description": "Invalid input" },
          "403": { "description": "Untrusted Host or Origin" }
        }
      }
    },
    "/api/preferences/import": {
      "post": {
        "summary": "Optional owner-run legacy hidden/color import; see OSCAR-SETUP.md",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "type": "object", "required": ["calendars", "hidden"],
          "properties": {
            "calendars": {"type": "array", "maxItems": 100, "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 300}, "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}}},
            "hidden": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
          }
        }}}},
        "responses": {
          "200": {"description": "Applied known preferences; matched local count and unmatched old ids returned"},
          "400": {"description": "Invalid preferences; nothing written"},
          "403": {"description": "Untrusted Host or Origin"}
        }
      }
    },
    "/api/calendars/visibility": {
      "post": {
        "summary": "Set visible boolean for a known calendar id",
        "responses": {
          "200": { "description": "Success" },
          "400": { "description": "Invalid input" },
          "403": { "description": "Untrusted Host or Origin" }
        }
      }
    },
    "/api/sources": {
      "get": {
        "summary": "List saved iCal sources without their private URLs",
        "responses": {
          "200": { "description": "Redacted source list" },
          "403": { "description": "Untrusted Host or Origin" }
        }
      },
      "post": {
        "summary": "Add and immediately fetch a private Google iCal source",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "url"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 300 },
                  "url": { "type": "string", "description": "Private https:// or webcal:// calendar.google.com iCal URL" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Source saved and its events committed" },
          "400": { "description": "Invalid link, feed, or input" },
          "403": { "description": "Untrusted Host or Origin" },
          "413": { "description": "Request body too large" },
          "500": { "description": "Storage failure; previous snapshot retained" }
        }
      }
    },
    "/api/sources/remove": {
      "post": {
        "summary": "Remove one iCal source and its imported events",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "minLength": 1, "maxLength": 300 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Source removed" },
          "400": { "description": "Unknown source id" },
          "403": { "description": "Untrusted Host or Origin" },
          "500": { "description": "Storage failure; previous snapshot retained" }
        }
      }
    },
    "/mcp": {
      "post": {
        "summary": "Stateless JSON-RPC MCP: calendar_events and sync_status read-only tools",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          }
        }
      }
    },
    "/api/switches": {
      "get": {"summary": "Read the owner's Calendar feature switches (contract wizard.app-switches/1); every switch is off by default", "responses": {"200": {"description": "{contract, switches: [{id, name, description, on, default, issues}]}"}, "403": {"description": "Untrusted Host or Origin"}}},
      "post": {"summary": "Turn one feature switch on or off for the owner (browser request: Origin and X-Wizard-Switch: 1 required)", "parameters": [{"name": "X-Wizard-Switch", "in": "header", "required": true, "schema": {"type": "string", "enum": ["1"]}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["id", "on"], "properties": {"id": {"type": "string"}, "on": {"type": "boolean"}}}}}}, "responses": {"200": {"description": "The same listing as GET"}, "400": {"description": "Invalid body"}, "403": {"description": "Untrusted Host or Origin, or not an owner browser request"}, "404": {"description": "Unknown switch id"}}}
    },
    "/api/sync": {
      "get": {
        "summary": "Read grant-scoped Connected accounts sync state",
        "responses": {
          "200": {
            "description": "Sync state, last_success, last_error, accounts, calendar_errors, setup_url, syncing and interval_minutes"
          }
        }
      },
      "post": {
        "summary": "Refresh saved iCal sources now and request an asynchronous Connected accounts sync; poll GET until syncing is false",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Only iCal sources are configured: refresh completed (ok, synced, failed) or coalesced with a running refresh (syncing true)"
          },
          "202": {
            "description": "Connected accounts refresh queued or coalesced with a pending refresh; saved iCal sources were refreshed before the reply"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Untrusted Host or Origin"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Service identity and setup status",
        "responses": {
          "200": { "description": "Success" },
          "400": { "description": "Invalid input" },
          "403": { "description": "Untrusted Host or Origin" }
        }
      }
    }
  }
}
